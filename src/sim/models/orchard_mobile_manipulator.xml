<mujoco model="orchard_mobile_manipulator">
  <compiler angle="radian" coordinate="local" meshdir="meshes"/>
  
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.7" specular="0.3 0.3 0.3"/>
    <rgba haze="0.85 0.88 0.92 1"/>
    <global fovy="55" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <!-- Textures & Materials -->
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.9 0.95 1.0" width="512" height="512"/>
    <texture name="tex_soil" type="2d" builtin="flat" rgb1="0.45 0.35 0.25" rgb2="0.4 0.3 0.2" width="512" height="512"/>
    <texture name="tex_chassis" type="2d" builtin="flat" rgb1="0.15 0.16 0.18" width="128" height="128"/>
    <texture name="tex_arm" type="2d" builtin="flat" rgb1="0.92 0.94 0.96" width="128" height="128"/>
    <texture name="tex_bark" type="2d" builtin="flat" rgb1="0.35 0.25 0.18" width="128" height="128"/>
    <texture name="tex_leaf" type="2d" builtin="flat" rgb1="0.15 0.55 0.15" width="128" height="128"/>
    <texture name="tex_weed" type="2d" builtin="flat" rgb1="0.25 0.7 0.15" width="128" height="128"/>
    <texture name="tex_fruit" type="2d" builtin="flat" rgb1="0.85 0.15 0.15" width="128" height="128"/>

    <material name="mat_soil" texture="tex_soil" roughness="0.9" reflectance="0.05"/>
    <material name="mat_chassis" texture="tex_chassis" specular="0.4" shininess="0.3"/>
    <material name="mat_arm" texture="tex_arm" specular="0.6" shininess="0.5"/>
    <material name="mat_metal" rgba="0.7 0.75 0.8 1" specular="0.8" shininess="0.8"/>
    <material name="mat_tire" rgba="0.1 0.1 0.1 1" roughness="0.9"/>
    <material name="mat_tank" rgba="0.9 0.95 1.0 0.85"/>
    <material name="mat_bark" texture="tex_bark" roughness="0.9"/>
    <material name="mat_leaf" texture="tex_leaf"/>
    <material name="mat_weed" texture="tex_weed"/>
    <material name="mat_fruit" texture="tex_fruit" specular="0.5"/>
    <material name="mat_nozzle" rgba="0.9 0.7 0.1 1"/>
  </asset>

  <worldbody>
    <!-- Terrain / Ground Plane -->
    <geom name="ground" type="plane" size="20 20 0.1" material="mat_soil" friction="1.2 0.05 0.005"/>
    <light directional="true" pos="3 -3 6" dir="-0.5 0.5 -1" castshadow="true" diffuse="0.9 0.85 0.8"/>

    <!-- ========================================== -->
    <!-- POMEGRANATE SAPLING & WEED CLUSTER SCENE   -->
    <!-- ========================================== -->
    <body name="pomegranate_tree" pos="0.85 0.45 0">
      <!-- Main trunk (Keep-out barrier for arm) -->
      <geom name="trunk_base" type="cylinder" size="0.04 0.35" pos="0 0 0.35" material="mat_bark"/>
      <geom name="trunk_mid" type="cylinder" size="0.035 0.3" pos="0.02 0 0.85" material="mat_bark"/>
      
      <!-- Canopy Branches -->
      <geom name="branch_left" type="capsule" fromto="0 0 0.9 -0.15 0.1 1.2" size="0.025" material="mat_bark"/>
      <geom name="branch_right" type="capsule" fromto="0 0 0.95 0.2 -0.1 1.3" size="0.025" material="mat_bark"/>
      <geom name="branch_front" type="capsule" fromto="0 0 1.0 0.05 0.25 1.4" size="0.02" material="mat_bark"/>

      <!-- Foliage / Leaves -->
      <geom name="leaf_cluster1" type="ellipsoid" size="0.25 0.25 0.2" pos="-0.15 0.1 1.25" material="mat_leaf"/>
      <geom name="leaf_cluster2" type="ellipsoid" size="0.3 0.3 0.25" pos="0.2 -0.1 1.35" material="mat_leaf"/>
      <geom name="leaf_cluster3" type="ellipsoid" size="0.35 0.35 0.3" pos="0.05 0.25 1.45" material="mat_leaf"/>

      <!-- Pomegranate Fruits -->
      <geom name="fruit1" type="sphere" size="0.045" pos="-0.22 0.08 1.15" material="mat_fruit"/>
      <geom name="fruit2" type="sphere" size="0.05" pos="0.26 -0.12 1.25" material="mat_fruit"/>
      <geom name="fruit3" type="sphere" size="0.042" pos="0.08 0.32 1.38" material="mat_fruit"/>

      <!-- Weed Clusters at Tree Base (Target for Weeding) -->
      <body name="weed_patch_1" pos="-0.12 0.08 0.03">
        <geom name="weed_g1" type="capsule" fromto="0 0 0 -0.04 0.02 0.08" size="0.012" material="mat_weed"/>
        <geom name="weed_g2" type="capsule" fromto="0 0 0 0.03 0.04 0.09" size="0.012" material="mat_weed"/>
        <geom name="weed_g3" type="capsule" fromto="0 0 0 -0.01 -0.03 0.07" size="0.012" material="mat_weed"/>
      </body>
      <body name="weed_patch_2" pos="0.10 -0.06 0.03">
        <geom name="weed_g4" type="capsule" fromto="0 0 0 0.04 -0.02 0.08" size="0.012" material="mat_weed"/>
        <geom name="weed_g5" type="capsule" fromto="0 0 0 -0.03 -0.03 0.09" size="0.012" material="mat_weed"/>
      </body>
    </body>

    <!-- ========================================== -->
    <!-- 4WD ROVER CHASSIS & 6-DOF MANIPULATOR      -->
    <!-- ========================================== -->
    <body name="rover_chassis" pos="0 0 0.25">
      <freejoint name="chassis_freejoint"/>
      
      <!-- Rover Main Frame -->
      <geom name="chassis_geom" type="box" size="0.45 0.3 0.12" material="mat_chassis" mass="35"/>
      <geom name="top_plate" type="box" size="0.42 0.28 0.01" pos="0 0 0.13" material="mat_metal" mass="5"/>
      <geom name="front_bumper" type="capsule" fromto="0.46 -0.28 0.0 0.46 0.28 0.0" size="0.03" material="mat_metal"/>
      <geom name="rear_bumper" type="capsule" fromto="-0.46 -0.28 0.0 -0.46 0.28 0.0" size="0.03" material="mat_metal"/>

      <!-- Liquid Nutrition / Irrigation Tank on Rear Deck -->
      <geom name="liquid_tank" type="cylinder" size="0.14 0.15" pos="-0.22 0 0.25" zaxis="0 1 0" material="mat_tank" mass="10"/>

      <!-- 4WD High-Clearance Lug Wheels -->
      <!-- Front Left Wheel -->
      <body name="wheel_fl" pos="0.28 0.36 -0.02">
        <joint name="joint_wheel_fl" type="hinge" axis="0 1 0" damping="0.5"/>
        <geom name="geom_wheel_fl" type="cylinder" size="0.15 0.06" zaxis="0 1 0" material="mat_tire" mass="4" friction="1.5 0.05 0.01"/>
      </body>
      <!-- Front Right Wheel -->
      <body name="wheel_fr" pos="0.28 -0.36 -0.02">
        <joint name="joint_wheel_fr" type="hinge" axis="0 1 0" damping="0.5"/>
        <geom name="geom_wheel_fr" type="cylinder" size="0.15 0.06" zaxis="0 1 0" material="mat_tire" mass="4" friction="1.5 0.05 0.01"/>
      </body>
      <!-- Rear Left Wheel -->
      <body name="wheel_rl" pos="-0.28 0.36 -0.02">
        <joint name="joint_wheel_rl" type="hinge" axis="0 1 0" damping="0.5"/>
        <geom name="geom_wheel_rl" type="cylinder" size="0.15 0.06" zaxis="0 1 0" material="mat_tire" mass="4" friction="1.5 0.05 0.01"/>
      </body>
      <!-- Rear Right Wheel -->
      <body name="wheel_rr" pos="-0.28 -0.36 -0.02">
        <joint name="joint_wheel_rr" type="hinge" axis="0 1 0" damping="0.5"/>
        <geom name="geom_wheel_rr" type="cylinder" size="0.15 0.06" zaxis="0 1 0" material="mat_tire" mass="4" friction="1.5 0.05 0.01"/>
      </body>

      <!-- Rover Perception Camera (Looking forward-right at crops) -->
      <camera name="rover_orchard_cam" pos="0.45 0.2 0.3" euler="-0.2 0.3 -0.1"/>

      <!-- ========================================== -->
      <!-- 6-DOF ARTICULATED ROBOTIC MANIPULATOR ARM  -->
      <!-- Mounted on Forward Top Deck               -->
      <!-- ========================================== -->
      <body name="arm_base" pos="0.15 0 0.14">
        <geom name="arm_base_mount" type="cylinder" size="0.09 0.05" material="mat_arm" mass="3"/>
        
        <!-- Joint 1: Base Yaw Rotation -->
        <body name="link_1" pos="0 0 0.05">
          <joint name="joint_1_yaw" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="1.5"/>
          <geom name="link_1_geom" type="cylinder" size="0.08 0.08" pos="0 0 0.08" material="mat_arm" mass="2.5"/>

          <!-- Joint 2: Shoulder Pitch -->
          <body name="link_2" pos="0 0 0.16">
            <joint name="joint_2_shoulder" type="hinge" axis="0 1 0" range="-1.8 1.8" damping="1.5"/>
            <geom name="link_2_geom" type="capsule" fromto="0 0 0 0 0 0.38" size="0.06" material="mat_arm" mass="3.5"/>

            <!-- Joint 3: Elbow Pitch -->
            <body name="link_3" pos="0 0 0.38">
              <joint name="joint_3_elbow" type="hinge" axis="0 1 0" range="-2.4 2.4" damping="1.2"/>
              <geom name="link_3_geom" type="capsule" fromto="0 0 0 0.35 0 0" size="0.05" material="mat_arm" mass="2.8"/>

              <!-- Joint 4: Forearm Roll -->
              <body name="link_4" pos="0.35 0 0">
                <joint name="joint_4_forearm_roll" type="hinge" axis="1 0 0" range="-3.14 3.14" damping="0.8"/>
                <geom name="link_4_geom" type="cylinder" size="0.045 0.05" pos="0.05 0 0" zaxis="1 0 0" material="mat_arm" mass="1.8"/>

                <!-- Joint 5: Wrist Pitch -->
                <body name="link_5" pos="0.10 0 0">
                  <joint name="joint_5_wrist_pitch" type="hinge" axis="0 1 0" range="-1.8 1.8" damping="0.6"/>
                  <geom name="link_5_geom" type="capsule" fromto="0 0 0 0.08 0 0" size="0.04" material="mat_arm" mass="1.2"/>

                  <!-- Joint 6: Tool Flange Roll -->
                  <body name="link_6_flange" pos="0.08 0 0">
                    <joint name="joint_6_wrist_roll" type="hinge" axis="1 0 0" range="-3.14 3.14" damping="0.4"/>
                    <geom name="link_6_geom" type="cylinder" size="0.038 0.03" pos="0.03 0 0" zaxis="1 0 0" material="mat_arm" mass="0.8"/>

                    <!-- ============================================== -->
                    <!-- DUAL-ACTION END-EFFECTOR TOOLHEAD              -->
                    <!-- (1) Rotary Weeding Cultivator Blade             -->
                    <!-- (2) Micro-Irrigation / Fertilizer Spray Nozzle  -->
                    <!-- ============================================== -->
                    <body name="dual_action_toolhead" pos="0.06 0 0">
                      <!-- Toolhead Frame Housing -->
                      <geom name="tool_housing" type="box" size="0.04 0.04 0.06" pos="0 0 -0.04" material="mat_chassis" mass="0.6"/>
                      
                      <!-- Action 1: Rotary Weeding Cultivator Disc -->
                      <body name="rotary_weeder" pos="0 0 -0.12">
                        <joint name="joint_weeder_spin" type="hinge" axis="0 0 1" damping="0.05"/>
                        <geom name="weeder_disc" type="cylinder" size="0.07 0.008" material="mat_metal" mass="0.3"/>
                        <geom name="blade1" type="box" size="0.065 0.01 0.005" pos="0 0 -0.008" material="mat_metal"/>
                        <geom name="blade2" type="box" size="0.01 0.065 0.005" pos="0 0 -0.008" material="mat_metal"/>
                      </body>

                      <!-- Action 2: Directional Micro-Spray Nozzle -->
                      <geom name="spray_nozzle" type="cylinder" size="0.012 0.02" pos="0.03 0.02 -0.06" zaxis="1 1 -1" material="mat_nozzle"/>

                      <!-- Toolhead Eye-in-Hand Camera -->
                      <camera name="toolhead_camera" pos="0.05 0 -0.02" euler="0 1.2 0"/>
                      <site name="tool_tip" pos="0 0 -0.13" size="0.01" rgba="0 1 1 0.8"/>
                    </body>

                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Static Scene Camera for High-Resolution View of Weeding Sequence -->
    <camera name="tracking_view" pos="1.8 -1.2 1.2" euler="0.6 0.8 0.5"/>
    <camera name="side_action_cam" pos="1.4 0.2 0.8" euler="0.2 1.3 0.8"/>
  </worldbody>

  <!-- Actuators for Rover Wheels & 6-DOF Arm -->
  <actuator>
    <!-- Rover Mobility Drivetrain (Torque / Velocity) -->
    <motor name="act_wheel_fl" joint="joint_wheel_fl" gear="25"/>
    <motor name="act_wheel_fr" joint="joint_wheel_fr" gear="25"/>
    <motor name="act_wheel_rl" joint="joint_wheel_rl" gear="25"/>
    <motor name="act_wheel_rr" joint="joint_wheel_rr" gear="25"/>

    <!-- 6-DOF Manipulator Position Servos -->
    <position name="act_joint_1" joint="joint_1_yaw" kp="250" kv="20"/>
    <position name="act_joint_2" joint="joint_2_shoulder" kp="350" kv="25"/>
    <position name="act_joint_3" joint="joint_3_elbow" kp="280" kv="20"/>
    <position name="act_joint_4" joint="joint_4_forearm_roll" kp="150" kv="12"/>
    <position name="act_joint_5" joint="joint_5_wrist_pitch" kp="120" kv="10"/>
    <position name="act_joint_6" joint="joint_6_wrist_roll" kp="80" kv="8"/>

    <!-- Tool Rotary Weeder Motor (Continuous High-Speed Velocity) -->
    <velocity name="act_weeder_spin" joint="joint_weeder_spin" kv="10"/>
  </actuator>
</mujoco>
